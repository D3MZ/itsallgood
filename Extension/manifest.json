{
  "manifest_version": 3,
  "name": "It's All Good",
  "version": "0.1.0",
  "description": "Filters posts on X.",
  "icons": { "128": "icon.png" },
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["*://x.com/*", "*://twitter.com/*"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": ["*://x.com/*", "*://twitter.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_start"
  }],
  "action": { "default_title": "It's All Good", "default_icon": "icon.png", "default_popup": "popup.html" }
}
